# Copy this file to .env.local (gitignored) and fill in real values.
# Never put real secrets in this file.

# Anthropic API key used for joke moderation and the AI joke of the day.
ANTHROPIC_API_KEY=

# Auth.js secret for signing sessions (generate with: npx auth secret).
AUTH_SECRET=

# Google OAuth client ID (Google Cloud console, OAuth client for localhost).
# Google sign-in is offered only when both AUTH_GOOGLE_ID and AUTH_GOOGLE_SECRET
# are set. While both are empty, `npm run dev` offers a dev-only "Sign in as"
# test-user sign-in instead (SPEC D15); it never exists in a production build.
AUTH_GOOGLE_ID=

# Google OAuth client secret for the client above.
AUTH_GOOGLE_SECRET=

# Comma-separated user IDs that get admin rights, e.g. id1,id2.
ADMIN_USER_IDS=

# Folder for the local PGlite database (gitignored).
PGLITE_DATA_DIR=./.data/pglite

# Claude model for joke moderation (optional; default claude-opus-5-5).
# Without ANTHROPIC_API_KEY, local development skips moderation (SPEC D17)
# and production keeps new jokes pending until a key is configured.
MODERATION_MODEL=

# Public site address for share previews (og:url, og:image). Default http://localhost:3000.
SITE_URL=
